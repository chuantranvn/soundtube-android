<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <!-- Logo lượng tử trong app: lòng sứ trắng đục + quỹ đạo Quark + nút Play gradient -->
    <group
        android:translateX="-34"
        android:translateY="-34">
        <path android:pathData="M35,54 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="38"
                    android:startY="38"
                    android:endX="70"
                    android:endY="70">
                    <item android:offset="0" android:color="#FFDCE3EF" />
                    <item android:offset="1" android:color="#FFFFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M37,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="55"
                    android:centerY="54"
                    android:gradientRadius="17">
                    <item android:offset="0" android:color="#40FF2E63" />
                    <item android:offset="1" android:color="#00FF2E63" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Quỹ đạo lượng tử nghiêng -->
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="-26">
            <path
                android:pathData="M37,54 a17,6.8 0 1,0 34,0 a17,6.8 0 1,0 -34,0Z"
                android:strokeWidth="1.2"
                android:fillColor="#00000000">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="37"
                        android:startY="54"
                        android:endX="71"
                        android:endY="54">
                        <item android:offset="0" android:color="#FFFF2E63" />
                        <item android:offset="1" android:color="#FF7C4DFF" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:fillColor="#FFFF2E63"
                android:pathData="M69.2,54 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0Z" />
        </group>
        <!-- Nút Play ở tâm -->
        <path
            android:pathData="M50.5,47.5 L50.5,60.5 L61.5,54 Z"
            android:strokeWidth="3.5"
            android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="48"
                    android:startY="45"
                    android:endX="64"
                    android:endY="63">
                    <item android:offset="0" android:color="#FFFF2E63" />
                    <item android:offset="1" android:color="#FF7C4DFF" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="48"
                    android:startY="45"
                    android:endX="64"
                    android:endY="63">
                    <item android:offset="0" android:color="#FFFF2E63" />
                    <item android:offset="1" android:color="#FF7C4DFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
